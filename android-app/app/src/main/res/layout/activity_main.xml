<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_luxury">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NotifLogger"
            style="@style/Text.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pencatat notifikasi bank &amp; e-wallet ke Google Sheets"
            style="@style/Text.Body" />

        <View
            android:layout_width="64dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/divider_gold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="28dp"
            android:background="@drawable/card_luxury"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplikasi &amp; Sheet Tujuan"
                style="@style/Text.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pilih bank/e-wallet yang dipantau, lalu hubungkan ke Spreadsheet dan Sheet tujuannya."
                style="@style/Text.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="TERPANTAU SAAT INI"
                style="@style/Text.Label" />

            <TextView
                android:id="@+id/text_selected_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Belum dipilih"
                android:textColor="@color/ivory"
                android:fontFamily="@font/montserrat"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_pick_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Pilih Aplikasi &amp; Sheet Tujuan"
                style="@style/Button.Gold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_luxury"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akses Notifikasi"
                style="@style/Text.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Wajib diaktifkan agar NotifLogger bisa membaca notifikasi masuk dari HP ini."
                style="@style/Text.Body" />

            <Button
                android:id="@+id/btn_notif_access"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Buka Pengaturan Akses Notifikasi"
                style="@style/Button.Gold" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/montserrat"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.04"
                android:text="STATUS: BELUM DIAKTIFKAN" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_luxury"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keandalan Latar Belakang"
                style="@style/Text.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Supaya notifikasi tetap tercatat walau HP terkunci lama, matikan optimasi baterai dan aktifkan autostart untuk NotifLogger."
                style="@style/Text.Body" />

            <Button
                android:id="@+id/btn_battery_optimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Matikan Optimasi Baterai"
                style="@style/Button.Gold" />

            <TextView
                android:id="@+id/text_battery_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserrat"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.04"
                android:text="STATUS: OPTIMASI BATERAI MASIH AKTIF" />

            <Button
                android:id="@+id/btn_autostart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Buka Pengaturan Autostart HP"
                style="@style/Button.Gold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
