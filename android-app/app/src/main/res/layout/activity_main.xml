<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Catat Notifikasi Bank/E-wallet ke Google Sheets"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Pilih Aplikasi &amp; Sheet Tujuan"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/text_selected_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Belum dipilih" />

        <Button
            android:id="@+id/btn_pick_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Aplikasi"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_open_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buka Panel (Atur Sheet Tujuan)"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Izinkan Akses Notifikasi"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Wajib diaktifkan agar aplikasi bisa membaca notifikasi masuk." />

        <Button
            android:id="@+id/btn_notif_access"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buka Pengaturan Akses Notifikasi"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textStyle="italic" />

    </LinearLayout>
</ScrollView>
