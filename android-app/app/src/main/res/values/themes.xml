<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema mewah keemasan, disengaja satu tampilan gelap konsisten,
         tidak mengikuti light/dark system. -->
    <style name="Theme.NotifLogger" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/black_luxury</item>
        <item name="android:statusBarColor">@color/black_luxury</item>
        <item name="android:navigationBarColor">@color/black_luxury</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryDark">@color/gold_deep</item>
        <item name="colorAccent">@color/gold</item>
        <item name="colorControlNormal">@color/muted_gold_gray</item>
        <item name="colorControlActivated">@color/gold</item>

        <item name="android:textColorPrimary">@color/ivory</item>
        <item name="android:textColorSecondary">@color/muted_gold_gray</item>
        <item name="android:textColorHint">@color/muted_gold_gray</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="fontFamily">@font/montserrat</item>
    </style>

    <style name="Text.Display" parent="">
        <item name="android:fontFamily">@font/playfair_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.SectionTitle" parent="">
        <item name="android:fontFamily">@font/playfair_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ivory</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textColor">@color/muted_gold_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textColor">@color/muted_gold_gray</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Button.Gold" parent="android:Widget.Button">
        <item name="android:background">@drawable/button_gold_gradient</item>
        <item name="android:textColor">@color/black_luxury</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:elevation">3dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Card.Luxury" parent="">
        <item name="android:background">@drawable/card_luxury</item>
        <item name="android:padding">18dp</item>
    </style>

</resources>
